# Camera-solve server for Hybrid mode: pycolmap + numpy + headless OpenCV. No torch, no model weights.
FROM python:3.11-slim
RUN useradd --create-home --uid 10001 app
WORKDIR /srv
COPY deploy/requirements-sfm.txt .
RUN pip install --no-cache-dir -r requirements-sfm.txt
COPY src/vid3d/__init__.py src/vid3d/sfm.py src/vid3d/sfm_payload.py src/vid3d/sfm_server.py /srv/vid3d/
USER app
ENV PYTHONPATH=/srv PYTHONUNBUFFERED=1
EXPOSE 8787
# Browsers must be on the allow-list: add --origin https://your-site.example (repeatable)
CMD ["python", "-m", "vid3d.sfm_server", "--host", "0.0.0.0", "--port", "8787"]
